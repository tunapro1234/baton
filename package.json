{
  "name": "baton",
  "private": true,
  "description": "A shared care log you talk to: one record for everyone who looks after an older parent, served over MCP.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "contract",
    "server",
    "host",
    "proxy",
    "evals"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "eval:guardrail": "npm run eval:guardrail -w evals",
    "eval:numbers": "npm run eval:numbers -w evals",
    "eval:stt": "npm run eval:stt -w evals",
    "eval:stt:heldout": "npm run eval:stt -w evals -- --set heldout",
    "eval:guardrail:live": "npm run eval:guardrail:live -w evals",
    "check:voice": "node scripts/check-voice.ts",
    "demo": "node scripts/demo.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "voice-ready-mcp": "github:tunapro1234/voice-ready-mcp#v0.1.0"
  }
}
